### Mongo Express #################################################
# Upstream image tag used as the build base (latest stable).
ME_VERSION=1.0.2

# Host port the UI is published on. Defaults to 8087 to avoid colliding with
# phpmyadmin's 8081. Override in your root .env if you don't run phpmyadmin
# (e.g. set ME_PORT=8081).
ME_PORT=8087

# MongoDB connection (Laradock's `mongo` service by container name).
ME_CONFIG_MONGODB_SERVER=mongo
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ENABLE_ADMIN=false

# Basic auth on the mongo-express UI itself (independent of MongoDB auth).
# Override in your root .env before exposing the UI outside localhost.
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=pass

# UI site (optional; overrides the image's hardcoded defaults).
ME_CONFIG_SITE_BASEURL=/
ME_CONFIG_SITE_HOST=0.0.0.0
ME_CONFIG_SITE_PORT=8081
ME_CONFIG_SITE_TITLE=Mongo Express
